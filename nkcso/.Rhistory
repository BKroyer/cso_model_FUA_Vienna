server <- function(input, output, session) {
# Reactive filter for selected timestep
filtered_data <- reactive({
precip_data %>% filter(timestep == input$time)
})
# Initial map
output$map <- renderLeaflet({
leaflet() %>%
addTiles() %>%
addPolygons(data = fua, color = "black", weight = 1, fillOpacity = 0.3)
})
# Update map based on selected timestep
observe({
data <- filtered_data()
# Merge precipitation with FUAs using correct key
fua_merged <- fua %>%
left_join(data, by = c("eFUA_ID" = "FUA_ID"))
# Farbpalette
pal <- colorNumeric("Blues", domain = fua_merged$precip_mm_3h, na.color = "transparent")
# Labels sicher erzeugen: wenn eFUA_name fehlt -> FUA_ID anzeigen
fua_merged$label <- ifelse(!is.na(fua_merged$eFUA_name),
paste0("FUA: ", fua_merged$eFUA_name,
"<br>Precipitation: ", round(fua_merged$precip_mm_3h, 2), " mm"),
paste0("FUA ID: ", fua_merged$eFUA_ID,
"<br>Precipitation: ", round(fua_merged$precip_mm_3h, 2), " mm")
)
leafletProxy("map") %>%
clearShapes() %>%
addPolygons(
data = fua_merged,
fillColor = ~pal(precip_mm_3h),
color = "black",
weight = 1,
fillOpacity = 0.7,
label = ~lapply(label, HTML) # Label hier sicher einfügen
) %>%
addLegend(pal = pal, values = fua_merged$precip_mm_3h, title = "Precipitation (mm)")
})
# Run the application
shinyApp(ui, server)
