library(shiny)
library(leaflet)
library(sf)
library(dplyr)
library(lubridate)
library(data.table)
# Paths
fua_path <- "C:/Users/sim06/fua_example/GHS_FUA_UCDB2015_GLOBE_R2019A_54009_1K_V1_0.gpkg"
precip_path <- "C:/Users/sim06/Git/cso-modell/nkcso_testdaten/output_by_country"
# Load FUA boundaries
fua <- st_read(fua_path)
# Load precipitation CSVs
csv_files <- list.files(precip_path, pattern = "^precip_.*_merged\\.csv$", full.names = TRUE)
read_precip <- function(file) {
dt <- fread(file, colClasses = "character", select = c("FUA_ID", "precip_mm_3h", "timestep", "eFUA_name"))
# Clean data
dt <- dt[!is.na(timestep) & timestep != "", ]   # remove empty timesteps
# Convert data types
dt$timestep <- ymd_hms(dt$timestep, tz = "UTC")
dt$FUA_ID <- as.integer(dt$FUA_ID)
dt$precip_mm_3h <- as.numeric(dt$precip_mm_3h)
return(dt)
}
precip_data <- rbindlist(lapply(csv_files, read_precip))
# Check if data was parsed correctly
print(head(precip_data))
print(range(precip_data$timestep))
# UI
ui <- fluidPage(
titlePanel("3-hourly Precipitation in FUAs - 2015"),
sidebarLayout(
sidebarPanel(
sliderInput("time", "Select time:",
min = min(precip_data$timestep),
max = max(precip_data$timestep),
value = min(precip_data$timestep),
step = 3 * 3600,
timeFormat = "%Y-%m-%d %H:%M",
animate = animationOptions(interval = 1000, loop = TRUE)
)
),
mainPanel(
leafletOutput("map", height = "800px")
)
)
)
# Server
server <- function(input, output, session) {
filtered_data <- reactive({
precip_data %>% filter(timestep == input$time)
})
output$map <- renderLeaflet({
leaflet() %>%
addTiles() %>%
addPolygons(data = fua, color = "black", weight = 1, fillOpacity = 0.5)
})
observe({
data <- filtered_data()
# Merge precipitation with FUAs
fua_merged <- fua %>%
left_join(data, by = c("eFUA_ID" = "FUA_ID")) # Check if your GPKG has eFUA_ID or FUA_ID!
pal <- colorNumeric("Blues", domain = fua_merged$precip_mm_3h, na.color = "transparent")
leafletProxy("map") %>%
clearShapes() %>%
addPolygons(
data = fua_merged,
fillColor = ~pal(precip_mm_3h),
color = "black",
weight = 1,
fillOpacity = 0.7,
label = ~paste0("FUA: ", eFUA_name, "<br>Precipitation: ", round(precip_mm_3h, 2), " mm")
) %>%
addLegend(pal = pal, values = fua_merged$precip_mm_3h, title = "Precipitation (mm)")
})
}
shinyApp(ui, server)
print(names(fua))
library(shiny)
library(leaflet)
library(sf)
library(dplyr)
library(lubridate)
library(data.table)
# =========================
# 1. DATA LOADING
# =========================
# Paths
fua_path <- "C:/Users/sim06/fua_example/GHS_FUA_UCDB2015_GLOBE_R2019A_54009_1K_V1_0.gpkg"
precip_path <- "C:/Users/sim06/Git/cso-modell/nkcso_testdaten/output_by_country"
# Load FUAs and transform to WGS84 for leaflet
fua <- st_read(fua_path) %>%
st_transform(4326)
# Load precipitation CSV files
csv_files <- list.files(precip_path, pattern = "^precip_.*_merged\\.csv$", full.names = TRUE)
read_precip <- function(file) {
dt <- fread(file, colClasses = "character", select = c("FUA_ID", "precip_mm_3h", "timestep", "eFUA_name"))
# Remove invalid rows
dt <- dt[!is.na(timestep) & timestep != "", ]
# Convert types
dt$timestep <- ymd_hms(dt$timestep, tz = "UTC")
dt$FUA_ID <- as.integer(dt$FUA_ID)
dt$precip_mm_3h <- as.numeric(dt$precip_mm_3h)
return(dt)
}
precip_data <- rbindlist(lapply(csv_files, read_precip))
# Debug info (optional)
print(head(precip_data))
print(range(precip_data$timestep))
# =========================
# 2. SHINY UI
# =========================
ui <- fluidPage(
titlePanel("3-hourly Precipitation in FUAs - 2015"),
sidebarLayout(
sidebarPanel(
sliderInput("time", "Select time:",
min = min(precip_data$timestep, na.rm = TRUE),
max = max(precip_data$timestep, na.rm = TRUE),
value = min(precip_data$timestep, na.rm = TRUE),
step = 3 * 3600,
timeFormat = "%Y-%m-%d %H:%M",
animate = animationOptions(interval = 1000, loop = TRUE)
)
),
mainPanel(
leafletOutput("map", height = "800px")
)
)
)
# =========================
# 3. SHINY SERVER
# =========================
server <- function(input, output, session) {
# Reactive filter for selected timestep
filtered_data <- reactive({
precip_data %>% filter(timestep == input$time)
})
# Initial map
output$map <- renderLeaflet({
leaflet() %>%
addTiles() %>%
addPolygons(data = fua, color = "black", weight = 1, fillOpacity = 0.3)
})
# Update map based on selected timestep
observe({
data <- filtered_data()
# Merge precipitation with FUAs using correct join keys
fua_merged <- fua %>%
left_join(data, by = c("eFUA_ID" = "FUA_ID"))
pal <- colorNumeric("Blues", domain = fua_merged$precip_mm_3h, na.color = "transparent")
leafletProxy("map") %>%
clearShapes() %>%
addPolygons(
data = fua_merged,
fillColor = ~pal(precip_mm_3h),
color = "black",
weight = 1,
fillOpacity = 0.7,
label = ~paste0(
"FUA: ", eFUA_name,
"<br>Precipitation: ", round(precip_mm_3h, 2), " mm"
)
) %>%
addLegend(pal = pal, values = fua_merged$precip_mm_3h, title = "Precipitation (mm)")
})
}
# Run the application
shinyApp(ui, server)
